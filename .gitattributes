# Keep text normalisation identical to the main project so vendored
# snapshots and this repo's blobs hash-match. See project/.gitattributes.
*.ps1 text eol=crlf
*.bat text eol=crlf
.githooks/* text eol=lf
# WSL/bash scripts must stay LF everywhere (2026-08-29: CRLF in
# wsl-stage-linux-package.sh broke &quot;set -euo pipefail&quot; inside WSL and
# killed a linux packaging run).
*.sh text eol=lf
# Managed business content ships inside content zips whose files are
# sha256-pinned by MANIFEST.json and verified by the host on update; any
# checkout-time EOL rewrite would break every install. Pin content EOL.
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
